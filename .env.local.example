# ───────────────────────────────────────────────
# 지금 채울 것: GA4 웹 스트림의 측정 ID (G-XXXXXXXXXX)
# ⚠️ 값 넣은 뒤 dev 서버 재시작해야 적용됨 (NEXT_PUBLIC_*은 빌드 시점에 박힘)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# 로컬 DebugView 확인 때만 true. 배포 환경은 false 권장.
NEXT_PUBLIC_GA_DEBUG=false

# /admin 로그인. 실제 값은 .env.local/배포 환경에만 저장
ADMIN_PASSWORD=
# 선택: 비밀번호와 분리한 긴 임의 문자열(세션 서명용)
ADMIN_SESSION_SECRET=

# 배포 도메인 (미설정 시 example.com) — 배포 후 채우기. 빈 값(=)으로 두지 말 것
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ───────────────────────────────────────────────
# Supabase — 콘텐츠 DB + 어드민 인증 (supabase/schema.sql 실행 후 채우기)
# URL/anon은 클라이언트 노출 OK(RLS로 보호), service_role은 서버 전용 — 절대 NEXT_PUBLIC 금지
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# /admin 접근 허용 이메일(콤마 구분) — Supabase Auth에 같은 계정 생성 필요
ADMIN_EMAILS=

# ───────────────────────────────────────────────
# 쿠팡 파트너스 → Tools → 파트너스 API 에서 발급
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=
# Supabase Cron -> /api/cron/coupang 전용 인증값 (32자 이상, 서버 전용)
COUPANG_SYNC_SECRET=

# ───────────────────────────────────────────────
# AI 인사이트 스크립트 전용 (npm run insights) — 나중에, 데이터 쌓인 뒤
GA4_PROPERTY_ID=                                          # 숫자 속성 ID (G- 아님)
GOOGLE_APPLICATION_CREDENTIALS=./ga-service-account.json  # 로컬: 서비스 계정 JSON 경로
# 서버리스 배포에서는 위 JSON 파일 대신 아래 두 값 사용 가능
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# 또는 서비스 계정 JSON 전체를 한 줄 환경변수로 설정
GOOGLE_SERVICE_ACCOUNT_JSON=
ANTHROPIC_API_KEY=
INSIGHTS_MODEL=claude-sonnet-4-6
