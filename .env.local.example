# 쿠팡 파트너스 → Tools → 파트너스 API 에서 발급
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 채널/캠페인 추적용(선택)
COUPANG_SUB_ID=

# Google Analytics 4 — 클라이언트 측정 ID (미설정 시 GA 비활성 + no-op)
# GA4 관리 > 데이터 스트림에서 발급 (형식: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# AI 인사이트 스크립트 전용 (npm run insights) — 서버에서만 사용, 클라이언트 노출 X
GA4_PROPERTY_ID=                                    # 숫자 속성 ID (G- 아님)
GOOGLE_APPLICATION_CREDENTIALS=./ga-service-account.json  # 서비스 계정 JSON 경로
ANTHROPIC_API_KEY=
INSIGHTS_MODEL=claude-sonnet-4-6                    # (선택) 분석 모델
